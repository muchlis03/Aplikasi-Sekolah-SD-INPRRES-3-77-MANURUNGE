rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Helper Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Private Data Space (Strict Attribute-Based Access Control)
    match /users/{userId} {
      allow read, write: if isOwner(userId) && isValidId(userId);

      match /profile/{docId} {
        allow read, write: if isOwner(userId) && isValidId(docId);
      }

      match /appData/{docId} {
        allow read, write: if isOwner(userId) && isValidId(docId);
      }
    }

    // Applet Namespace Partition
    match /artifacts/{appId}/users/{userId}/appData/{docId} {
      allow read, write: if isOwner(userId) && isValidId(docId);
    }
  }
}
