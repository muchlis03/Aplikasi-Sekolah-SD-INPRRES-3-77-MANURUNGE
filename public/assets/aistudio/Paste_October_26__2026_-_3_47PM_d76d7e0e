function Attendance({ students, attendance, setAttendance }) {
  const [date, setDate] = useState(new Date().toISOString().split('T')[0]);
  const [selectedClass, setSelectedClass] = useState('Semua Kelas');

  const filteredStudents = selectedClass === 'Semua Kelas' ? students : students.filter(s => s.class === selectedClass);
  const currentAttendance = attendance[date] || {};

  const handleMark = (studentId, status) => {
    setAttendance({
      ...attendance,
      [date]: { ...currentAttendance, [studentId]: status }
    });
  };

  const STATUSES = ['Hadir', 'Sakit', 'Izin', 'Alpa'];

  return (
    <div className="space-y-6">
      <div className="flex flex-col sm:flex-row gap-4 justify-between items-center bg-white p-4 rounded-xl shadow-sm border border-gray-100">
        <div className="flex items-center gap-3">
          <CalendarIcon className="h-5 w-5 text-gray-500" />
          <input type="date" value={date} onChange={(e) => setDate(e.target.value)} className="border-none font-semibold text-gray-700 focus:ring-0 outline-none cursor-pointer" />
        </div>
        <select value={selectedClass} onChange={(e) => setSelectedClass(e.target.value)} className="border rounded-lg p-2 text-sm outline-none bg-gray-50">
          <option value="Semua Kelas">Semua Kelas</option>
          {CLASSES.map(c => <option key={c} value={c}>{c}</option>)}
        </select>
      </div>
      <div className="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
        <div className="overflow-x-auto">
          <table className="w-full text-left border-collapse">
            <thead>
              <tr className="bg-gray-50 text-gray-600 text-xs uppercase tracking-wider">
                <th className="p-4 border-b font-medium">Nama Murid</th>
                <th className="p-4 border-b font-medium">Kelas</th>
                <th className="p-4 border-b font-medium text-center">Status Kehadiran</th>
              </tr>
            </thead>
            <tbody className="text-sm divide-y divide-gray-100">
              {filteredStudents.map(student => {
                const status = currentAttendance[student.id] || 'Belum Diabsen';
                return (
                  <tr key={student.id} className="hover:bg-gray-50">
                    <td className="p-4 font-medium text-gray-800">{student.name}<span className="block text-xs text-gray-400 font-normal">{student.nis}</span></td>
                    <td className="p-4">{student.class}</td>
                    <td className="p-4">
                      <div className="flex justify-center gap-2">
                        {STATUSES.map(s => {
                          const isSelected = status === s;
                          let btnColor = 'bg-gray-100 text-gray-600 hover:bg-gray-200';
                          if (isSelected) {
                            if (s === 'Hadir') btnColor = 'bg-green-500 text-white shadow-sm';
                            else if (s === 'Alpa') btnColor = 'bg-red-500 text-white shadow-sm';
                            else btnColor = 'bg-yellow-500 text-white shadow-sm';
                          }
                          return (
                            <button key={s} onClick={() => handleMark(student.id, s)} className={`px-3 py-1.5 rounded-md text-xs font-medium transition-colors ${btnColor}`}>
                              {s}
                            </button>
                          );
                        })}
                      </div>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  );
}

function Grades({ students, grades, setGrades, schoolInfo }) {
  const [selectedClass, setSelectedClass] = useState('Kelas 1');
  const [selectedSubject, setSelectedSubject] = useState(SUBJECTS[0]);
  const [showPrintHint, setShowPrintHint] = useState(false);

  const filteredStudents = students.filter(s => s.class === selectedClass);
  const key = `${selectedClass}-${selectedSubject}`;
  const currentScores = grades[key] || {};
  
  const handleAssessmentChange = (studentId, field, value) => {
    const studentData = currentScores[studentId] || {
      diagnostik: '', formatif: '', s1: '', s2: '', s3: '', s4: '', s5: '',
      tp: 'Belum Dinilai', bukti: '', deskripsi: '', tindakLanjut: ''
    };

    let finalValue = value;
    // Validasi angka untuk diagnostik, formatif, dan sumatif tp 1-5
    if (['diagnostik', 'formatif', 's1', 's2', 's3', 's4', 's5'].includes(field)) {
      finalValue = parseInt(value);
      if (isNaN(finalValue)) finalValue = '';
      if (finalValue > 100) finalValue = 100;
      if (finalValue < 0) finalValue = 0;
    }

    setGrades({
      ...grades,
      [key]: { ...currentScores, [studentId]: { ...studentData, [field]: finalValue } }
    });
  };

  const handlePrint = () => {
    setShowPrintHint(true);
    setTimeout(() => setShowPrintHint(false), 8000);
