          </button>
        </div>
      </div>

      <div className="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden print:border-none print:shadow-none print:overflow-visible">
        <div className="p-6 text-center border-b border-gray-200 mb-4 hidden print:block">
          <h2 className="text-xl font-bold uppercase">{schoolInfo.name}</h2>
          <p className="text-sm">{schoolInfo.address} - NPSN: {schoolInfo.npsn}</p>
          <hr className="my-2 border-black" />
          <h3 className="font-bold text-lg mt-4">
            {reportType === 'attendance' ? 'REKAPITULASI KEHADIRAN MURID' : 'REKAPITULASI NILAI MURID'}
          </h3>
          <p className="text-sm">Kelas: {selectedClass} | Tahun Ajaran: {schoolInfo.academicYear} | Semester: {schoolInfo.semester || 'Ganjil'}</p>
        </div>

        <div className="overflow-x-auto p-4 print:overflow-visible print:p-0">
          <table className="w-full text-left border-collapse border border-gray-300 print:text-xs">
            <thead>
              <tr className="bg-gray-100 text-gray-800 text-xs uppercase text-center">
                <th className="p-3 border border-gray-300 font-bold w-12">No</th>
                <th className="p-3 border border-gray-300 font-bold text-left">Nama Murid</th>
                {reportType === 'attendance' ? (
                  <>
                    <th className="p-3 border border-gray-300 font-bold w-16">H</th>
                    <th className="p-3 border border-gray-300 font-bold w-16">S</th>
                    <th className="p-3 border border-gray-300 font-bold w-16">I</th>
                    <th className="p-3 border border-gray-300 font-bold w-16">A</th>
                    <th className="p-3 border border-gray-300 font-bold w-24">% Hadir</th>
                  </>
                ) : (
                  <>
                    {SUBJECTS.map(sub => <th key={sub} className="p-3 border border-gray-300 font-bold w-16" title={sub}>{sub.substring(0,3)}</th>)}
                    <th className="p-3 border border-gray-300 font-bold w-16">Rata</th>
                  </>
                )}
              </tr>
            </thead>
            <tbody className="text-sm">
              {filteredStudents.length > 0 ? filteredStudents.map((student, idx) => {
                if (reportType === 'attendance') {
                  const stat = calculateAttendance(student.id);
                  const totalAbsensi = stat.had + stat.sak + stat.iz + stat.alp;
                  const persentase = totalAbsensi > 0 ? Math.round((stat.had / totalAbsensi) * 100) : 0;
                  return (
                    <tr key={student.id} className="text-center">
                      <td className="p-3 border border-gray-300">{idx + 1}</td>
                      <td className="p-3 border border-gray-300 text-left font-medium">{student.name}</td>
                      <td className="p-3 border border-gray-300 text-green-600 font-bold">{stat.had}</td>
                      <td className="p-3 border border-gray-300 text-yellow-600 font-bold">{stat.sak}</td>
                      <td className="p-3 border border-gray-300 text-orange-500 font-bold">{stat.iz}</td>
                      <td className="p-3 border border-gray-300 text-red-600 font-bold">{stat.alp}</td>
                      <td className="p-3 border border-gray-300 text-blue-600 font-bold bg-blue-50/50">{persentase}%</td>
                    </tr>
                  );
                } else {
                  let total = 0;
                  let count = 0;
                  return (
                    <tr key={student.id} className="text-center">
                      <td className="p-3 border border-gray-300">{idx + 1}</td>
                      <td className="p-3 border border-gray-300 text-left font-medium">{student.name}</td>
                      {SUBJECTS.map(sub => {
                        const key = `${selectedClass}-${sub}`;
                        const gradeData = grades[key]?.[student.id];
                        
                        let displayScore = '-';
                        let numericScore = null;

                        if (typeof gradeData === 'number') {
                           numericScore = gradeData;
                        } else if (gradeData && typeof gradeData === 'object') {
                           // Rata-rata Formatif dan Sumatif (dari 5 TP)
                           const f = gradeData.formatif;
                           
                           let sumatifTotal = 0;
                           let sumatifCount = 0;
                           for (let i = 1; i <= 5; i++) {
                             const val = gradeData[`s${i}`];
                             if (val !== '' && val !== undefined) {
                               sumatifTotal += Number(val);
                               sumatifCount++;
                             }
                           }
                           const s = sumatifCount > 0 ? (sumatifTotal / sumatifCount) : undefined;

                           if (f !== '' && f !== undefined && s !== undefined) {
                             numericScore = Math.round((Number(f) + s) / 2);
                           } else if (f !== '' && f !== undefined) {
                             numericScore = Number(f);
                           } else if (s !== undefined) {
                             numericScore = Math.round(s);
                           }
                        }

                        if (numericScore !== null) {
                           displayScore = numericScore;
                           total += numericScore;
                           count++;
                        }
                        
                        return <td key={sub} className="p-3 border border-gray-300">{displayScore}</td>;
                      })}
                      <td className="p-3 border border-gray-300 font-bold bg-gray-50">{count > 0 ? (total/count).toFixed(1) : '-'}</td>
                    </tr>
                  );
                }
              }) : (
                <tr><td colSpan={reportType === 'attendance' ? 7 : SUBJECTS.length + 3} className="p-8 text-center text-gray-500 border border-gray-300">Tidak ada murid.</td></tr>
              )}
            </tbody>
          </table>
        </div>

        {/* Tanda Tangan Cetak */}
        <div className="hidden print:flex justify-between p-8 mt-8 w-full">
          <div className="text-center w-64">
            <p className="mb-24">Mengetahui,<br/>Kepala Sekolah</p>
            <p className="font-bold underline">{schoolInfo.headmaster || '...................................'}</p>
            <p className="text-sm">NIP. {schoolInfo.headmasterNip || '...................................'}</p>
          </div>
          <div className="text-center w-64">
