import React, { useState, useEffect, useMemo } from 'react';
import { initializeApp } from 'firebase/app';
import { 
  getAuth, signInAnonymously, signInWithCustomToken, onAuthStateChanged, 
  signInWithPopup, GoogleAuthProvider, signOut, 
  createUserWithEmailAndPassword, signInWithEmailAndPassword, sendPasswordResetEmail 
} from 'firebase/auth';
import { getFirestore, doc, setDoc, onSnapshot, getDoc } from 'firebase/firestore';
import { 
  Users, UserCheck, UserX, Clock, FileText, Settings, 
  Search, Menu, X, Plus, Edit2, Trash2, Printer, 
  ChevronDown, GraduationCap, LayoutDashboard, Calendar as CalendarIcon, 
  BookOpen, Award, Save, LogOut, Lock, Mail, Eye, EyeOff, Cloud, RefreshCw, CheckCircle2, AlertCircle
} from 'lucide-react';
import { 
  BarChart, Bar, XAxis, YAxis, CartesianGrid, Tooltip as RechartsTooltip, Legend as RechartsLegend, ResponsiveContainer,
  PieChart, Pie, Cell
} from 'recharts';

// --- FIREBASE INIT ---
let firebaseApp, auth, db;
let isFirebaseAvailable = false;
const appId = typeof __app_id !== 'undefined' ? __app_id : 'default-app-id';

try {
  if (typeof __firebase_config !== 'undefined') {
    const firebaseConfig = JSON.parse(__firebase_config);
    firebaseApp = initializeApp(firebaseConfig);
    auth = getAuth(firebaseApp);
    db = getFirestore(firebaseApp);
    isFirebaseAvailable = true;
    console.log("Cloud Storage terdeteksi dan berhasil diinisialisasi.");
  } else {
    console.warn("Menunggu konfigurasi Cloud disuntikkan oleh sistem...");
  }
} catch (error) {
  console.error("Error saat inisialisasi Cloud:", error);
}

// --- DEFAULT DATA ---
const defaultSchoolInfo = {
  name: 'SD INPRES 3/77 MANURUNGE',
  npsn: '40302982',
  level: 'SD',
  address: 'JALAN ANDALAS',
  phone: '082346049815',
  principal: 'MUCHLIS, S. Pd Gr',
  principalNip: '19850512 201001 1 015',
  principalTitle: 'Guru Mata Pelajaran',
  headmaster: 'NAMA KEPALA SEKOLAH, S.Pd., M.Pd',
  headmasterNip: '19700101 200003 2 001',
  academicYear: '2026-2027',
  semester: 'Ganjil',
  teacherPhoto: '',
  schoolLogo: '',
  customFields: []
};

const CLASSES = ['Kelas 1', 'Kelas 2', 'Kelas 3', 'Kelas 4', 'Kelas 5', 'Kelas 6'];
const SUBJECTS = ['Pendidikan Agama Islam', 'Matematika', 'Bahasa Indonesia', 'IPAS', 'PPKn', 'Seni Budaya', 'PJOK', 'Bahasa Inggris', 'Bahasa Daerah', 'Pendidikan Pancasila'];

const initialStudents = [
  { id: '1', name: 'Andi Mappanyukki', class: 'Kelas 1', nis: '1001', gender: 'Laki-laki' },
  { id: '2', name: 'Siti Aminah', class: 'Kelas 1', nis: '1002', gender: 'Perempuan' },
  { id: '3', name: 'Budi Santoso', class: 'Kelas 2', nis: '1003', gender: 'Laki-laki' },
  { id: '4', name: 'Rina Nose', class: 'Kelas 3', nis: '1004', gender: 'Perempuan' },
  { id: '5', name: 'Ahmad Dahlan', class: 'Kelas 4', nis: '1005', gender: 'Laki-laki' },
  { id: '6', name: 'Cut Nyak Dien', class: 'Kelas 5', nis: '1006', gender: 'Perempuan' },
  { id: '7', name: 'Hasanuddin', class: 'Kelas 6', nis: '1007', gender: 'Laki-laki' },
];

// --- COMPONENTS ---

export default function App() {
  const [firebaseUser, setFirebaseUser] = useState(null);
  const [isDbReady, setIsDbReady] = useState(false);
  const [syncStatus, setSyncStatus] = useState('idle'); // 'idle', 'syncing', 'saved', 'error'

  const [activeTab, setActiveTab] = useState('dashboard');
  const [isMobileMenuOpen, setIsMobileMenuOpen] = useState(false);
  
  const [schoolInfo, setSchoolInfo] = useState(defaultSchoolInfo);
  const [students, setStudents] = useState(initialStudents);
  const [attendance, setAttendance] = useState({});
  const [grades, setGrades] = useState({});

  const COLORS = ['#0088FE', '#00C49F', '#FFBB28', '#FF8042', '#8884D8', '#ff7300'];

  // 1. Inisialisasi Autentikasi Penyimpanan Cloud
  useEffect(() => {
    if (!auth) {
      // Jika auth belum siap, kita beri waktu sistem untuk memuat
      setTimeout(() => setIsDbReady(true), 2000);
      return;
    }

    const initAuth = async () => {
      try {
        if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
          await signInWithCustomToken(auth, __initial_auth_token);
        } else {
          await signInAnonymously(auth);
        }
      } catch (e) {
        console.error("Auth init error", e);
      }
    };
    initAuth();
    const unsubscribe = onAuthStateChanged(auth, setFirebaseUser);
    return () => unsubscribe();
  }, []);

  // 2. Tarik & Sinkronisasi Data dari Penyimpanan Cloud
  useEffect(() => {
    if (!auth || !firebaseUser) {
      if (!auth) setIsDbReady(true);
      return;
    }
    
    // Cek apakah user sedang login resmi menggunakan akun (bukan anonim) 
    // atau menggunakan token platform khusus.
    const isPlatformUser = typeof __initial_auth_token !== 'undefined' && __initial_auth_token;
    const isAuthenticated = !firebaseUser.isAnonymous || isPlatformUser;
    
    if (!isAuthenticated) {
      setIsDbReady(true);
      return; 
    }

    const uid = firebaseUser.uid;
    let unsubscribes = [];

    // Sinkronisasi data real-time dari Firestore (Autosave & Resume State)
    const syncDoc = (docName, setState, defaultValue, transformIn = (d)=>d) => {
      const docRef = doc(db, 'artifacts', appId, 'users', uid, 'appData', docName);
      return onSnapshot(docRef, (snap) => {
        if (snap.exists()) {
          setState(transformIn(snap.data()));
        } else {
          setState(defaultValue);
        }
      }, (err) => {
        console.error("Gagal menarik data dari cloud:", err);
        setSyncStatus('error');
      });
    };

    unsubscribes.push(syncDoc('schoolInfo', setSchoolInfo, defaultSchoolInfo));
    unsubscribes.push(syncDoc('students', (d) => setStudents(d.list || []), { list: initialStudents }));
    unsubscribes.push(syncDoc('attendance', setAttendance, {}));
    unsubscribes.push(syncDoc('grades', setGrades, {}));

    setIsDbReady(true);
    return () => unsubscribes.forEach(unsub => unsub());
  }, [firebaseUser]);

  // Fungsi helper untuk Auto-Save dengan status indikator ke Cloud
  const handleAutoSave = async (docName, data) => {
    setSyncStatus('syncing');

    if (!auth || !firebaseUser) {
      setSyncStatus('error');
      return;
    }

    try {
      await setDoc(doc(db, 'artifacts', appId, 'users', firebaseUser.uid, 'appData', docName), data);
      setSyncStatus('saved');
      setTimeout(() => setSyncStatus('idle'), 3000);
    } catch (error) {
      console.error("Gagal menyimpan ke cloud:", error);
      setSyncStatus('error');
    }
  };

  // Wrapper untuk menyimpan state yang sekaligus Auto-Save ke Firestore Cloud
  const handleSetSchoolInfo = (info) => {
    setSchoolInfo(info);
    handleAutoSave('schoolInfo', info);
  };

  const handleSetStudents = (list) => {
    setStudents(list);
    handleAutoSave('students', { list });
  };

  const handleSetAttendance = (data) => {
    setAttendance(data);
    handleAutoSave('attendance', data);
  };

  const handleSetGrades = (data) => {
    setGrades(data);
    handleAutoSave('grades', data);
  };

  const handleLogout = async () => {
    if (auth) {
      await signOut(auth);
      // Restart sesi anonim secara otomatis sesuai standar keamanan sistem
      await signInAnonymously(auth);
    }
    setActiveTab('dashboard');
  };

  if (!isDbReady) {
    return (
      <div className="flex h-screen items-center justify-center bg-gray-100">
        <div className="text-center">
          <div className="w-12 h-12 border-4 border-blue-500 border-t-transparent rounded-full animate-spin mx-auto mb-4"></div>
          <p className="text-gray-600 font-medium">Memuat dan menyinkronkan data Anda...</p>
        </div>
      </div>
    );
  }

  // Lindungi area aplikasi hanya untuk user yang terotentikasi di Cloud
  const isPlatformUser = typeof __initial_auth_token !== 'undefined' && __initial_auth_token;
  const isAuthenticated = firebaseUser && (!firebaseUser.isAnonymous || isPlatformUser);

  if (!isAuthenticated) {
    return <Login />;
  }

  const userName = firebaseUser?.displayName || firebaseUser?.email?.split('@')[0] || 'Guru';

  const renderContent = () => {
    switch (activeTab) {
      case 'dashboard':
        return <Dashboard students={students} attendance={attendance} schoolInfo={schoolInfo} COLORS={COLORS} />;
      case 'students':
        return <StudentManagement students={students} setStudents={handleSetStudents} />;
      case 'attendance':
        return <Attendance students={students} attendance={attendance} setAttendance={handleSetAttendance} />;
      case 'grades':
        return <Grades students={students} grades={grades} setGrades={handleSetGrades} schoolInfo={schoolInfo} />;
      case 'reports':
        return <Reports students={students} attendance={attendance} grades={grades} schoolInfo={schoolInfo} />;
      case 'settings':
        return <SettingsPanel schoolInfo={schoolInfo} setSchoolInfo={handleSetSchoolInfo} />;
      default:
        return <Dashboard students={students} attendance={attendance} schoolInfo={schoolInfo} COLORS={COLORS} />;
    }
  };

  let navItems = [
    { id: 'dashboard', label: 'Dashboard', icon: LayoutDashboard },
    { id: 'students', label: 'Data Murid', icon: Users },
    { id: 'attendance', label: 'Presensi', icon: UserCheck },
    { id: 'grades', label: 'Daftar Nilai', icon: Award },
    { id: 'reports', label: 'Rekap & Laporan', icon: FileText },
    { id: 'settings', label: 'Pengaturan', icon: Settings }
  ];

  // Helper untuk merender indikator status penyimpanan
  const renderSyncStatus = () => {
    switch (syncStatus) {
      case 'syncing':
        return <div className="flex items-center gap-1.5 text-xs font-medium text-blue-600 bg-blue-50 px-2 py-1 rounded-full"><RefreshCw className="h-3 w-3 animate-spin" /> Menyimpan ke Cloud...</div>;
      case 'saved':
        return <div className="flex items-center gap-1.5 text-xs font-medium text-green-600 bg-green-50 px-2 py-1 rounded-full"><CheckCircle2 className="h-3 w-3" /> Tersimpan di Cloud</div>;
      case 'error':
        return <div className="flex items-center gap-1.5 text-xs font-medium text-red-600 bg-red-50 px-2 py-1 rounded-full"><AlertCircle className="h-3 w-3" /> Gagal Sinkronisasi Cloud</div>;
      default:
        return <div className="flex items-center gap-1.5 text-xs font-medium text-blue-500"><Cloud className="h-3 w-3" /> Cloud Aktif</div>;
    }
  };

  return (
    <div className="flex h-screen bg-gray-100 font-sans overflow-hidden print:h-auto print:overflow-visible print:bg-white print:block">
      {/* Sidebar */}
      <aside className={`bg-[#001f3f] text-white w-64 flex-shrink-0 transition-transform duration-300 ease-in-out z-20 fixed md:relative h-full print:hidden ${isMobileMenuOpen ? 'translate-x-0' : '-translate-x-full md:translate-x-0'}`}>
        <div className="p-5 flex items-center justify-between border-b border-blue-900">
          <div className="flex items-center gap-3">
            <SchoolLogo src={schoolInfo.schoolLogo} />
            <span className="font-bold text-lg tracking-wider">GURU HEBAT</span>
          </div>
          <button className="md:hidden" onClick={() => setIsMobileMenuOpen(false)}>
            <X className="h-6 w-6 text-gray-300" />
          </button>
        </div>
        <div className="p-4 overflow-y-auto h-[calc(100%-140px)]">
          <p className="text-xs text-gray-400 uppercase tracking-wider mb-2">Menu Utama</p>
          <nav className="space-y-1">
            {navItems.map((item) => {
              const Icon = item.icon;
              const isActive = activeTab === item.id;
              return (
                <button
                  key={item.id}
                  onClick={() => { setActiveTab(item.id); setIsMobileMenuOpen(false); }}
                  className={`w-full flex items-center gap-3 px-4 py-3 rounded-lg transition-colors text-left ${isActive ? 'bg-blue-600 text-white shadow-md' : 'text-gray-300 hover:bg-blue-900 hover:text-white'}`}
                >
                  <Icon className="h-5 w-5" />
                  <span className="font-medium text-sm">{item.label}</span>
                </button>
              );
            })}
          </nav>
        </div>
        <div className="absolute bottom-0 w-full p-4 border-t border-blue-900 bg-[#001f3f]">
          <div className="flex items-center gap-3 mb-4">
            <div className="w-8 h-8 rounded-full bg-blue-500 flex items-center justify-center text-white font-bold uppercase">
              {userName.charAt(0)}
            </div>
            <div>
              <p className="text-sm font-medium text-white max-w-[150px] truncate">{userName}</p>
              <p className="text-xs text-green-400 font-semibold flex items-center gap-1"><Cloud className="w-3 h-3"/> Akun Cloud</p>
            </div>
          </div>
          <button 
            onClick={handleLogout}
            className="w-full flex items-center justify-center gap-2 px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg transition-colors text-sm font-medium"
          >
            <LogOut className="h-4 w-4" /> Keluar
          </button>
        </div>
      </aside>

      {/* Main Content */}
      <main className="flex-1 flex flex-col h-full overflow-hidden print:h-auto print:overflow-visible">
        {/* Topbar */}
        <header className="bg-white h-16 flex items-center justify-between px-4 lg:px-8 shadow-sm flex-shrink-0 z-10 print:hidden">
          <div className="flex items-center gap-4">
            <button className="md:hidden text-gray-500" onClick={() => setIsMobileMenuOpen(true)}>
              <Menu className="h-6 w-6" />
            </button>
            <h1 className="text-xl font-semibold text-gray-800 hidden sm:block flex items-center gap-3">
              Sistem Informasi <span className="text-blue-600">{schoolInfo.name}</span>
            </h1>
            <div className="hidden md:block ml-4">
              {renderSyncStatus()}
            </div>
          </div>
          <div className="flex items-center gap-4">
            <div className="text-right hidden sm:block">
              <p className="text-sm font-bold text-gray-800">{schoolInfo.principal}</p>
              <p className="text-xs text-gray-500">{schoolInfo.principalTitle}</p>
            </div>
            {schoolInfo.teacherPhoto ? (
              <img src={schoolInfo.teacherPhoto} alt="Guru" className="h-10 w-10 rounded-full object-cover border-2 border-gray-200 shadow-sm flex-shrink-0" />
            ) : (
              <div className="h-10 w-10 rounded-full bg-blue-100 flex items-center justify-center border-2 border-gray-200 shadow-sm flex-shrink-0">
                <Users className="h-5 w-5 text-blue-600" />
              </div>
            )}
          </div>
        </header>

        {/* Scrollable Content Area */}
        <div className="flex-1 overflow-auto p-4 lg:p-8 bg-gray-50 print:overflow-visible print:p-0 print:bg-white">
          <div className="max-w-7xl mx-auto print:max-w-full">
            {renderContent()}
          </div>
        </div>
      </main>
    </div>
  );
}

// --- SUB-COMPONENTS ---

function Dashboard({ students, attendance, schoolInfo, COLORS }) {
  const today = new Date().toISOString().split('T')[0];
  const todayAttendance = attendance[today] || {};
  
  const totalStudents = students.length;
  const presentCount = Object.values(todayAttendance).filter(v => v === 'Hadir').length;
  const absentCount = Object.values(todayAttendance).filter(v => ['Sakit', 'Izin', 'Alpa'].includes(v)).length;
  
  const classDistribution = CLASSES.map(cls => ({
    name: cls,
    value: students.filter(s => s.class === cls).length
  })).filter(item => item.value > 0);

  return (
    <div className="space-y-6">
      <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 print:hidden">
        <StatCard title="Total Murid" value={totalStudents} icon={Users} color="bg-blue-500" />
        <StatCard title="Hadir Hari Ini" value={presentCount} icon={UserCheck} color="bg-green-500" />
        <StatCard title="Tidak Hadir" value={absentCount} icon={UserX} color="bg-red-500" />
        <StatCard title="Total Kelas" value={CLASSES.length} icon={BookOpen} color="bg-cyan-500" />
      </div>

      <div className="bg-white p-6 rounded-xl shadow-sm border border-gray-100 flex flex-col sm:flex-row items-center sm:items-start gap-6 print:hidden">
        {schoolInfo.teacherPhoto ? (
          <img src={schoolInfo.teacherPhoto} alt="Profil" className="w-24 h-24 rounded-xl object-cover border-4 border-blue-100 shadow-md flex-shrink-0" />
        ) : (
          <div className="w-24 h-24 rounded-xl bg-blue-50 flex items-center justify-center border-4 border-blue-100 shadow-md flex-shrink-0 text-blue-300">
            <Users className="w-12 h-12" />
          </div>
        )}
        <div className="text-center sm:text-left flex-1">
          <h3 className="text-xl font-bold text-gray-800">{schoolInfo.principal}</h3>
          <p className="text-sm font-medium text-blue-600 mb-2">{schoolInfo.principalTitle}</p>
          <p className="text-sm text-gray-500 max-w-2xl leading-relaxed">
            Selamat datang di Sistem Informasi Presensi <strong>Guru Hebat</strong>. 
            Sistem ini dirancang untuk mempermudah Bapak/Ibu dalam mengelola data kehadiran murid serta manajemen nilai harian secara digital dan efisien di {schoolInfo.name}.
          </p>
        </div>
      </div>

      <div className="grid grid-cols-1 lg:grid-cols-2 gap-6 print:block print:w-full">
        <div className="bg-white p-6 rounded-xl shadow-sm border border-gray-100 print:shadow-none print:border-none print:p-0">
          <h3 className="text-lg font-semibold text-gray-800 mb-4 flex items-center gap-2">
            <GraduationCap className="h-5 w-5 text-blue-600 print:hidden" /> Identitas Sekolah
          </h3>
          <div className="flex flex-col sm:flex-row gap-6 items-center sm:items-start mb-6">
            <SchoolLogo large src={schoolInfo.schoolLogo} />
            <div className="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm w-full flex-1">
              <InfoItem label="Nama" value={schoolInfo.name} />
              <InfoItem label="NPSN" value={schoolInfo.npsn} />
              <InfoItem label="Alamat" value={schoolInfo.address} />
              <InfoItem label="Telepon" value={schoolInfo.phone} />
              <InfoItem label="Kepala Sekolah" value={schoolInfo.headmaster || '-'} />
              <InfoItem label="NIP Kepala Sekolah" value={schoolInfo.headmasterNip || '-'} />
              <InfoItem label={schoolInfo.principalTitle} value={schoolInfo.principal} />
              <InfoItem label="NIP Pengampu" value={schoolInfo.principalNip || '-'} />
              <InfoItem label="Tahun Ajaran" value={schoolInfo.academicYear} />
              <InfoItem label="Semester" value={schoolInfo.semester || 'Ganjil'} />
              {schoolInfo.customFields && schoolInfo.customFields.map((field, idx) => (
                <InfoItem key={idx} label={field.label || 'Info Tambahan'} value={field.value} />
              ))}
            </div>
          </div>
        </div>

        <div className="bg-white p-6 rounded-xl shadow-sm border border-gray-100 print:hidden">
          <h3 className="text-lg font-semibold text-gray-800 mb-4 flex items-center gap-2">
            <BarChart className="h-5 w-5 text-blue-600" /> Distribusi Murid Per Kelas
          </h3>
          <div className="h-48 w-full">
            <ResponsiveContainer width="100%" height="100%">
              <PieChart>
                <Pie
                  data={classDistribution}
                  cx="50%"
                  cy="50%"
                  innerRadius={60}
                  outerRadius={80}
                  paddingAngle={5}
                  dataKey="value"
                >
                  {classDistribution.map((entry, index) => (
                    <Cell key={`cell-${index}`} fill={COLORS[index % COLORS.length]} />
                  ))}
                </Pie>
                <RechartsTooltip />
                <RechartsLegend />
              </PieChart>
            </ResponsiveContainer>
          </div>
        </div>
      </div>

      <div className="hidden print:flex justify-between w-full mt-12 px-8">
        <div className="text-center w-64">
          <p className="mb-24">Mengetahui,<br/>Kepala Sekolah</p>
          <p className="font-bold underline">{schoolInfo.headmaster || '...................................'}</p>
          <p className="text-sm">NIP. {schoolInfo.headmasterNip || '...................................'}</p>
        </div>
        <div className="text-center w-64">
          <p className="mb-24"><br/>{schoolInfo.principalTitle}</p>
          <p className="font-bold underline">{schoolInfo.principal}</p>
          <p className="text-sm">NIP. {schoolInfo.principalNip || '...................................'}</p>
        </div>
      </div>
    </div>
  );
}

function StudentManagement({ students, setStudents }) {
  const [formData, setFormData] = useState({ name: '', class: 'Kelas 1', nis: '', gender: 'Laki-laki' });
  const [searchTerm, setSearchTerm] = useState('');
  const [studentToDelete, setStudentToDelete] = useState(null);
  const [editingStudent, setEditingStudent] = useState(null);
  const [saveMessage, setSaveMessage] = useState('');

  const showNotification = (msg) => {
    setSaveMessage(msg);
    setTimeout(() => setSaveMessage(''), 3000);
  };

  const handleAdd = (e) => {
    e.preventDefault();
    if (!formData.name || !formData.nis) return;
    const newStudent = { ...formData, id: Date.now().toString() };
    setStudents([...students, newStudent]);
    setFormData({ name: '', class: 'Kelas 1', nis: '', gender: 'Laki-laki' });
    showNotification('Data murid baru berhasil ditambahkan & disimpan!');
  };

  const executeDelete = () => {
    if (studentToDelete) {
      setStudents(students.filter(s => s.id !== studentToDelete));
      setStudentToDelete(null);
      showNotification('Data murid berhasil dihapus!');
    }
  };

  const handleUpdate = (e) => {
    e.preventDefault();
    if (!editingStudent.name || !editingStudent.nis) return;
    setStudents(students.map(s => s.id === editingStudent.id ? editingStudent : s));
    setEditingStudent(null);
    showNotification('Perubahan data murid berhasil disimpan!');
  };

  const filteredStudents = students.filter(s => 
    s.name.toLowerCase().includes(searchTerm.toLowerCase()) || 
    s.nis.includes(searchTerm)
  );

  return (
    <div className="space-y-6">
      {/* Notifikasi Simpan */}
      {saveMessage && (
        <div className="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-xl shadow-sm flex items-center gap-3 transition-all animate-in fade-in slide-in-from-top-4">
          <div className="bg-green-100 p-1 rounded-full">
            <Save className="h-4 w-4 text-green-600" />
          </div>
          <span className="text-sm font-medium">{saveMessage}</span>
        </div>
      )}

      {/* Modal Edit Murid */}
      {editingStudent && (
        <div className="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
          <div className="bg-white rounded-xl shadow-xl max-w-md w-full p-6">
            <h3 className="text-lg font-semibold text-gray-800 mb-4 flex items-center gap-2">
              <Edit2 className="h-5 w-5 text-blue-600" /> Edit Data Murid
            </h3>
            <form onSubmit={handleUpdate} className="space-y-4">
              <div>
                <label className="block text-xs font-medium text-gray-600 mb-1">NIS</label>
                <input type="text" required value={editingStudent.nis} onChange={e => setEditingStudent({...editingStudent, nis: e.target.value})} className="w-full border rounded-lg p-2 text-sm focus:ring-2 focus:ring-blue-500 outline-none" />
              </div>
              <div>
                <label className="block text-xs font-medium text-gray-600 mb-1">Nama Lengkap</label>
